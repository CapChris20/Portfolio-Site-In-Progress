.garage
    .container
        width 480px
        max-width calc(100vw - 40px)

    .content
        > .title
            font-size 1.5rem
            color #ff9ed4
            margin-bottom 0.75rem

    .garage-prompt
        font-size 1.05rem
        line-height 1.5
        color #ffceca
        margin-bottom 1.25rem

    .garage-choices
        display flex
        flex-direction column
        gap 10px
        margin-bottom 1.25rem

        .garage-choice
            width 100%
            text-align center

    .garage-cancel
        width 100%
        text-align center
