$hero-pixel = 'Press Start 2P', cursive
$hero-orange = #ff8500
$hero-pink = #e040fb
$hero-purple = #9333ea
$hero-deep = #14002a

.hero
    position fixed
    inset 0
    z-index 50
    display flex
    align-items center
    justify-content flex-end
    padding-right clamp(28px, 7vw, 96px)
    padding-left clamp(42%, 46vw, 52%)
    color #ffffff
    pointer-events auto
    overflow hidden
    font-family $hero-pixel
    transition opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.7s cubic-bezier(0.4, 0, 0.2, 1), transform 0.7s cubic-bezier(0.4, 0, 0.2, 1)

    @media only screen and (max-width 820px)
        padding-left 0
        padding-right 20px
        justify-content center

    &.is-leaving
        opacity 0
        visibility hidden
        pointer-events none
        transform scale(1.04)

        .hero-content
            transform translateY(-18px)
            opacity 0

.hero-backdrop
    position absolute
    inset 0
    background $hero-deep
    background radial-gradient(ellipse 140% 100% at 20% -10%, #ff8500 0%, transparent 46%), radial-gradient(ellipse 120% 90% at 85% 110%, $hero-purple 0%, transparent 52%), linear-gradient(165deg, #0a0018 0%, #2d004f 42%, #14002a 100%)
    animation heroBackdropDrift 18s ease-in-out infinite alternate

.hero-model
    position absolute
    left 0
    top 0
    bottom 0
    width clamp(42%, 46vw, 52%)
    height 100%
    z-index 2
    pointer-events none
    opacity 1

    @media only screen and (max-width 820px)
        width 100%
        height 52%
        bottom auto
        opacity 0.82

    @media only screen and (max-width 720px)
        opacity 0.72

.hero-stars
    position absolute
    inset -50%
    z-index 1
    opacity 0.55
    background-image radial-gradient(1px 1px at 20px 30px, #ffffff, transparent), radial-gradient(1px 1px at 80px 120px, #ffffffcc, transparent), radial-gradient(1.5px 1.5px at 160px 60px, #ffb997, transparent), radial-gradient(1px 1px at 240px 180px, #ffffffaa, transparent), radial-gradient(1px 1px at 320px 40px, #e040fb, transparent), radial-gradient(1.5px 1.5px at 400px 220px, #ffffff, transparent)
    background-size 440px 260px
    animation heroStarsDrift 90s linear infinite

.hero-sun
    position absolute
    left 24%
    bottom 18%
    z-index 1
    width min(72vw, 520px)
    height min(72vw, 520px)
    transform translateX(-50%)
    border-radius 50%
    background radial-gradient(circle, #ffb997 0%, #ff8500 22%, #e040fb55 48%, transparent 72%)
    filter blur(28px)
    opacity 0.72
    animation heroSunPulse 6s ease-in-out infinite

.hero-grain
    position absolute
    inset 0
    z-index 3
    opacity 0.14
    background-image url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E")
    animation heroGrain 0.35s steps(2) infinite
    pointer-events none

.hero-scanlines
    position absolute
    inset 0
    z-index 3
    opacity 0.08
    background repeating-linear-gradient(0deg, transparent, transparent 2px, #000000 2px, #000000 4px)
    pointer-events none

.hero-vignette
    position absolute
    inset 0
    z-index 4
    background radial-gradient(ellipse 70% 68% at 68% 46%, transparent 32%, #000000cc 100%)
    pointer-events none

.hero-content
    position relative
    z-index 3
    width min(100%, 520px)
    margin-left auto
    padding 48px 12px 64px 20px
    text-align center
    transition transform 0.7s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.55s ease
    animation heroContentIn 1.1s cubic-bezier(0.16, 1, 0.3, 1) both

    @media only screen and (max-width 820px)
        width min(94vw, 520px)
        margin-left 0
        margin-top clamp(38vh, 42vw, 46%)
        padding 32px 20px 64px

.hero-eyebrow
    margin 0 0 28px
    font-size clamp(0.45rem, 2.2vw, 0.62rem)
    line-height 1.8
    letter-spacing 0.08em
    color #ffb997
    text-shadow 0 0 12px #ff850088
    animation heroEyebrowBlink 3.5s ease-in-out infinite

.hero-title
    margin 0 0 24px
    display flex
    flex-direction column
    align-items center
    gap clamp(10px, 2.5vw, 16px)

.hero-title-line
    display block
    font-family $hero-pixel
    font-size clamp(1.35rem, 6.5vw, 2.35rem)
    line-height 1.35
    letter-spacing 0.06em
    color #fff5e8
    text-transform uppercase
    text-shadow 2px 2px 0 $hero-orange, 4px 4px 0 #cc5c00, 6px 6px 0 $hero-pink, 8px 8px 0 $hero-purple, 10px 10px 0 #2d004f, 0 0 32px #ff850066, 0 0 64px #e040fb44
    animation heroTitleFloat 4.5s ease-in-out infinite

    &:nth-child(2)
        animation-delay 0.15s
        color #ffe8d4

.hero-subtitle
    margin 0 0 40px
    max-width 34em
    margin-left auto
    margin-right auto
    font-family "Nunito", sans-serif
    font-size clamp(0.82rem, 2.4vw, 1rem)
    font-weight 700
    line-height 1.65
    letter-spacing 0.04em
    color #ffffffb8

.hero-status
    display flex
    flex-direction column
    align-items center
    gap 16px
    min-height 88px

.hero-loader
    margin 0
    font-size clamp(0.5rem, 2.4vw, 0.68rem)
    line-height 1.8
    letter-spacing 0.06em
    color #ffb997
    text-shadow 0 0 10px #ff850066

    &.is-hidden
        display none

.hero-progress
    width min(168px, 48vw)
    height 6px
    padding 1px
    border 1px solid #ff850066
    background #14002acc
    box-shadow inset 0 0 6px #00000088, 0 0 10px #9333ea33

    &.is-hidden
        display none

.hero-progress-bar
    display block
    width 0%
    height 100%
    background linear-gradient(90deg, $hero-orange 0%, $hero-pink 55%, $hero-purple 100%)
    box-shadow 0 0 8px #ff850088
    transition width 0.35s ease-out

.hero-start
    display none
    flex-direction column
    align-items center
    gap 10px
    margin 0
    padding 20px 32px 18px
    border 3px solid #ffffff44
    border-radius 0
    background linear-gradient(180deg, #ff850033 0%, #9333ea44 100%)
    box-shadow 4px 4px 0 #2d004f, 0 0 24px #e040fb55, inset 0 0 20px #ffffff08
    color #ffffff
    cursor pointer
    transition transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease
    animation heroPressStartBlink 1.2s step-end infinite

    &.is-visible
        display inline-flex

    &:hover
        transform translate(-2px, -2px)
        border-color #ffb997
        box-shadow 6px 6px 0 #2d004f, 0 0 36px #ff850088, inset 0 0 24px #ffffff12

    &:active
        transform translate(2px, 2px)
        box-shadow 2px 2px 0 #2d004f, 0 0 16px #e040fb44

.hero-start-label
    font-family $hero-pixel
    font-size clamp(0.72rem, 3.2vw, 0.92rem)
    line-height 1.6
    letter-spacing 0.04em
    text-shadow 2px 2px 0 $hero-purple, 0 0 16px #ff850088

.hero-start-hint
    font-family $hero-pixel
    font-size clamp(0.38rem, 1.8vw, 0.5rem)
    line-height 1.8
    letter-spacing 0.04em
    color #ffffff99

.hero-credits
    position absolute
    bottom clamp(48px, 11vh, 80px)
    left 0
    right 0
    z-index 3
    margin 0
    text-align center
    font-size clamp(0.36rem, 1.6vw, 0.46rem)
    line-height 1.8
    letter-spacing 0.08em
    color #ffffff55
    text-transform lowercase

html.has-hero
    background $hero-deep

    .menu-trigger,
    .map-trigger
        display none !important

@keyframes heroBackdropDrift
    0%
        transform scale(1) translate3d(0, 0, 0)
    100%
        transform scale(1.06) translate3d(-1.5%, 1%, 0)

@keyframes heroStarsDrift
    0%
        transform translate3d(0, 0, 0)
    100%
        transform translate3d(-120px, -80px, 0)

@keyframes heroSunPulse
    0%, 100%
        opacity 0.62
        transform translateX(-50%) scale(1)
    50%
        opacity 0.82
        transform translateX(-50%) scale(1.06)

@keyframes heroGrain
    0%
        transform translate3d(0, 0, 0)
    100%
        transform translate3d(-3%, -2%, 0)

@keyframes heroContentIn
    0%
        opacity 0
        transform translateY(28px) scale(0.96)
    100%
        opacity 1
        transform translateY(0) scale(1)

@keyframes heroTitleFloat
    0%, 100%
        transform translateY(0)
    50%
        transform translateY(-4px)

@keyframes heroEyebrowBlink
    0%, 88%, 100%
        opacity 1
    92%
        opacity 0.45

@keyframes heroPressStartBlink
    0%, 55%
        opacity 1
    56%, 100%
        opacity 0.55
